{
    "name": "immer-yjs",
    "license": "MIT",
    "description": "Combine immer & y.js",
    "version": "2.0.0",
    "Author": "LCZ",
    "repository": {
        "type": "git",
        "url": "https://github.com/sep2/immer-yjs.git"
    },
    "type": "module",
    "main": "./dist/immer-yjs.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/immer-yjs.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "vite build",
        "test": "NODE_NO_WARNINGS=1 vitest run",
        "coverage": "vitest run --coverage",
        "copy-readme": "cp ../../readme.md readme.md",
        "release": "yarn copy-readme && standard-version",
        "types:check": "tsc -b",
        "lint": "eslint ."
    },
    "peerDependencies": {
        "immer": "^11.1.18",
        "yjs": "^13.5.35"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@microsoft/api-extractor": "^7.59.1",
        "eslint": "^10.10.0",
        "globals": "^17.12.0",
        "happy-dom": "^20.14.3",
        "immer": "^11.1.18",
        "standard-version": "^9.5.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.70.0",
        "unplugin-dts": "^1.1.0",
        "vite": "^8.2.2",
        "vitest": "^5.0.0",
        "yjs": "^13.5.35"
    },
    "keywords": [
        "immer",
        "yjs",
        "crdt"
    ]
}
